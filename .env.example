# App
NEXT_PUBLIC_SITE_URL=https://delhifiling.com

# Payload CMS
PAYLOAD_SECRET=your-strong-secret-here

# Database (AWS RDS PostgreSQL)
DATABASE_URI=postgresql://user:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/delhifilling

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS S3 (Media uploads)
S3_BUCKET=delhifilling-media

# AWS SES (Email)
SES_FROM_EMAIL=info@delhifiling.com
AWS_SES_SMTP_USER=your-ses-smtp-user
AWS_SES_SMTP_PASS=your-ses-smtp-password

# Lead notification email
LEAD_NOTIFICATION_EMAIL=info@delhifiling.com

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
